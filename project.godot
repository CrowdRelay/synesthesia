; Engine configuration file.
; Synesthesia album experience — integrated with CrowdRelay through additive public contracts.
config_version=5

[application]
config/name="VIRYA: Synestezja"
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon-512.png"
boot_splash/image="res://assets/v2/branding/menu-world.webp"
boot_splash/bg_color=Color(0.027, 0.035, 0.031, 1)
boot_splash/show_image=true
boot_splash/show_image.web=false
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/minimum_display_time=0

[display/window]
size/viewport_width=1080
size/viewport_height=1920
dpi/allow_hidpi=true
stretch/mode="disabled"
handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[audio]
default_bus_layout="res://default_bus_layout.tres"

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[application_run]
disable_stdout=false
