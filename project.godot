; Engine configuration file.
; Synestezja vertical slice — intentionally standalone from Virya Signal.
config_version=5

[application]
config/name="VIRYA: Synestezja"
config/version="0.11.11"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display/window]
size/viewport_width=540
size/viewport_height=960
size/window_width_override=540
size/window_height_override=960
stretch/mode="canvas_items"
handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
default_bus_layout="res://default_bus_layout.tres"

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[application_run]
disable_stdout=false
