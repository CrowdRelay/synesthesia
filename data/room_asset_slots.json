{
  "version": 2,
  "style": "virya-signal-v2-moodboard-locked",
  "rules": {
    "master_min": "1080x1920",
    "alpha_props": "lossless-source -> webp/png runtime",
    "runtime_budget_per_room_kib": 900,
    "visual_language": "charcoal + thin signal hairlines + selective red/cyan/purple/dirty-white + waveform/rings + industrial stains",
    "faces": "abstract silhouettes only; no literal portrait treatment",
    "runtime_art": "all 11 scene/background/subject/foreground layers replaced in V2",
    "motion": "new authored room art owns image; legacy cinematics are low-amplitude texture only"
  },
  "rooms": {
    "wave-of-uncertainty": [
      "foam-foreground",
      "water-streaks",
      "horizon-signal",
      "spray-particles"
    ],
